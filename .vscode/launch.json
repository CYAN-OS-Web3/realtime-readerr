{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron Forge Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Electron Forge Start",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Doctor Check (no Electron)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run doctor:check",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Doctor Full Remote Auto-Retry",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run doctor:remote:auto",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Doctor Full Remote Auto-Retry (Quick)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run doctor:remote:auto:quick",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Renderer Only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build:renderer",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Electron App (Forge)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run package",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Windows Installer",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run package:win",
      "cwd": "${workspaceFolder}"
    }
  ]
}
