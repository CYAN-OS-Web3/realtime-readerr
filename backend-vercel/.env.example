# Cyan OS-lite Backend (RapidAPI) Environment Variables

# RapidAPI
RAPIDAPI_ONLY=true
RAPIDAPI_PROXY_SECRET=your-random-secret-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google TTS
GOOGLE_API_KEY=your-google-tts-api-key

# Azure TTS
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=your-default-voice-id
ALLOW_FREE_VOICE_CHANGES=false

# PayPal (for voice ID collection/monetization)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_MODE=sandbox
ENABLE_FAKE_PAYMENT=true
PAYPAL_PLAN_ID_BASIC=your-paypal-plan-id-basic
PAYPAL_PLAN_ID_STANDARD=your-paypal-plan-id-standard
PAYPAL_PLAN_ID_PRO=your-paypal-plan-id-pro
PAYPAL_PLAN_ID_TEAM=your-paypal-plan-id-team
PAYPAL_PLAN_ID_PREMIUM=your-paypal-plan-id-executive-pro-annual

# Frontend URL (used as fallback for PayPal return/cancel)
FRONTEND_URL=https://cyan-os-landingpage.vercel.app

# Admin (backend management endpoints)
ADMIN_SECRET=your-admin-secret
ADMIN_SECRET_DEV=your-admin-secret-dev

# Optional: NOWPayments (crypto)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret
NOWPAYMENTS_PAY_CURRENCY=usdtbsc

# Ocean (API sales channel)
OCEAN_PROXY_SECRET=your-ocean-gateway-secret
OCEAN_CONSUMER_SALT=your-ocean-consumer-salt
OCEAN_MONTHLY_CHARS=100000
OCEAN_ALLOW_ELEVENLABS=false

# Test (for local test script)
API_BASE=http://localhost:3000
TEST_USER_ID=test-user-123
TEST_DEVICE_ID=test-device-001